<Window x:Class="RestCue.App.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestCue – 今日統計" Height="520" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="今日統計" />
            <TextBlock x:Name="DateText" Margin="0,4,0,16"
                       Foreground="#666666" FontSize="13" />

            <Border Padding="16" CornerRadius="8" Background="#FFF3F4F6">
                <StackPanel>
                    <TextBlock x:Name="StatusText"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#CC0000" />

                    <TextBlock Margin="0,8,0,0" Foreground="#666666"
                               Text="有效工作時間" />
                    <TextBlock x:Name="WorkTimeText"
                               FontSize="20" FontWeight="SemiBold"
                               Text="—" />

                    <TextBlock Margin="0,8,0,0" Foreground="#666666"
                               Text="最長連續工作" />
                    <TextBlock x:Name="LongestWorkText"
                               FontSize="16" FontWeight="SemiBold"
                               Text="—" />

                    <TextBlock Margin="0,8,0,0" Foreground="#666666"
                               Text="平均工作週期" />
                    <TextBlock x:Name="AvgCycleText"
                               FontSize="16" FontWeight="SemiBold"
                               Text="—" />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Padding="16" CornerRadius="8"
                    Background="#FFF3F4F6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Foreground="#666666" Text="完整休息" />
                    <TextBlock x:Name="BreakCompletedText"
                               Grid.Row="0" Grid.Column="1"
                               FontWeight="SemiBold" Text="0" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Foreground="#666666" Text="明確離席重設" />
                    <TextBlock x:Name="IdleResetText"
                               Grid.Row="1" Grid.Column="1"
                               FontWeight="SemiBold" Text="0" />

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Foreground="#666666" Text="被動停頓" />
                    <TextBlock x:Name="PassivePauseText"
                               Grid.Row="2" Grid.Column="1"
                               FontWeight="SemiBold" Text="0" />

                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Foreground="#666666" Text="延後" />
                    <TextBlock x:Name="SnoozedText"
                               Grid.Row="3" Grid.Column="1"
                               FontWeight="SemiBold" Text="0" />

                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Foreground="#666666" Text="主動忽略" />
                    <TextBlock x:Name="IgnoredText"
                               Grid.Row="4" Grid.Column="1"
                               FontWeight="SemiBold" Text="0" />

                    <TextBlock Grid.Row="5" Grid.Column="0"
                               Foreground="#666666" Text="逾時未回應" />
                    <TextBlock x:Name="AutoDismissedText"
                               Grid.Row="5" Grid.Column="1"
                               FontWeight="SemiBold" Text="0" />
                </Grid>
            </Border>

            <TextBlock x:Name="DebtHistoryHeader"
                       Margin="0,12,0,4" FontSize="14" FontWeight="SemiBold"
                       Text="債務等級變化" />
            <TextBlock x:Name="DebtHistoryText"
                       Foreground="#666666" TextWrapping="Wrap" />

            <TextBlock x:Name="ReminderOutcomesHeader"
                       Margin="0,12,0,4" FontSize="14" FontWeight="SemiBold"
                       Text="提醒結果" />
            <TextBlock x:Name="ReminderOutcomesText"
                       Foreground="#666666" TextWrapping="Wrap" />

            <TextBlock x:Name="PerAppHeader"
                       Margin="0,12,0,4" FontSize="14" FontWeight="SemiBold"
                       Text="各程式使用時間" />
            <TextBlock x:Name="PerAppText"
                       Foreground="#666666" TextWrapping="Wrap" /> 
        </StackPanel>
    </ScrollViewer>
</Window>
