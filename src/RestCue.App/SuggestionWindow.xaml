<Window x:Class="RestCue.App.SuggestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestCue – 應用程式規則建議"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="300" Height="240"
        WindowStartupLocation="Manual"
        Background="Transparent"
        Foreground="{StaticResource ReminderTextBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        SnapsToDevicePixels="True">
    <Border CornerRadius="10,0,0,10"
            Background="{StaticResource ReminderSurfaceBrush}"
            Padding="18,16">
        <StackPanel>
            <TextBlock x:Name="MessageText"
                       FontSize="14"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="22"
                       LineStackingStrategy="BlockLineHeight"
                       AutomationProperties.Name="應用程式規則建議"
                       Margin="0,0,0,14" />

            <Button x:Name="ApproveButton"
                    Content="套用建議"
                    ToolTip="為此應用程式建立「僅系統列」規則，避免休息提醒干擾。"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Height="38"
                    Click="OnApproveButtonClick"
                    Background="{StaticResource SuccessBrush}"
                    Foreground="{StaticResource ReminderTextBrush}"
                    BorderThickness="0"
                    Margin="0,0,0,8" />
            <Button x:Name="DismissButton"
                    Content="不要套用"
                    ToolTip="不再為此應用程式提出建議。"
                    FontSize="13"
                    Height="34"
                    Click="OnDismissButtonClick"
                    Background="Transparent"
                    Foreground="{StaticResource ReminderTextBrush}"
                    BorderThickness="1"
                    BorderBrush="#66FFFFFF" />
        </StackPanel>
    </Border>
</Window>
