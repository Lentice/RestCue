<Window x:Class="RestCue.App.DuplicateInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestCue"
        WindowStartupLocation="CenterScreen"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="380">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="RestCue 已在執行。&#x0a;此視窗將在您確認後關閉，不影響正在執行的 RestCue。"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   LineHeight="22"
                   LineStackingStrategy="BlockLineHeight"
                   Margin="0,0,0,20" />

        <Button x:Name="ConfirmButton"
                Grid.Row="1"
                Content="確認"
                MinWidth="88"
                HorizontalAlignment="Center"
                IsDefault="True"
                IsCancel="True"
                Click="OnConfirmClick" />
    </Grid>
</Window>
