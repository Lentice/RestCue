<Window x:Class="RestCue.App.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestCue Edge Reminder"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="220" Height="300"
        WindowStartupLocation="Manual"
        Background="#EE2B2B2B"
        Foreground="White"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True">
    <Border CornerRadius="8,0,0,8" Background="#EE2B2B2B" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Time for a break"
                       FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12" />

            <StackPanel Grid.Row="1" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="PhaseText"
                           Text="Look at something\nsix meters away."
                           FontSize="13"
                           TextAlignment="Center"
                           LineHeight="20"
                           LineStackingStrategy="BlockLineHeight"
                           Margin="0,0,0,12" />

                <Rectangle x:Name="GuideVisual"
                           Width="40" Height="40"
                           Fill="#FF4CAF50"
                           RadiusX="4" RadiusY="4"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                <Button x:Name="CancelButton"
                        Content="結束休息"
                        FontSize="14"
                        Height="36"
                        Width="160"
                        Click="OnCancelButtonClick"
                        Cursor="Hand"
                        Background="#FFF44336"
                        Foreground="White"
                        BorderThickness="0"
                        Margin="0,0,0,6"
                        Visibility="Collapsed" />
                <Button x:Name="ActionButton"
                        FontSize="14"
                        Height="36"
                        Width="160"
                        Click="OnActionButtonClick"
                        Cursor="Hand"
                        Background="#FF4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        Margin="0,0,0,6" />
                <Button x:Name="SnoozeButton"
                        Content="Snooze"
                        FontSize="13"
                        Height="32"
                        Width="160"
                        Click="OnSnoozeButtonClick"
                        Cursor="Hand"
                        Background="#FF2196F3"
                        Foreground="White"
                        BorderThickness="0"
                        Margin="0,0,0,4" />
                <Button x:Name="IgnoreButton"
                        Content="Ignore"
                        FontSize="13"
                        Height="32"
                        Width="160"
                        Click="OnIgnoreButtonClick"
                        Cursor="Hand"
                        Background="#FF757575"
                        Foreground="White"
                        BorderThickness="0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
