<Window x:Class="RestCue.App.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestCue 邊緣提醒"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="228" Height="308"
        WindowStartupLocation="Manual"
        Background="Transparent"
        Foreground="{StaticResource ReminderTextBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        SnapsToDevicePixels="True">
    <Border CornerRadius="10,0,0,10"
            Background="{StaticResource ReminderSurfaceBrush}"
            Padding="18,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="該休息了"
                       FontSize="17" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       AutomationProperties.Name="休息提醒"
                       Margin="0,0,0,12" />

            <StackPanel Grid.Row="1" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="PhaseText"
                           Text="看向約六公尺外"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="22"
                           LineStackingStrategy="BlockLineHeight"
                           AutomationProperties.Name="休息引導提示"
                           Margin="0,0,0,14" />

                <Ellipse x:Name="GuideVisual"
                         Width="44" Height="44"
                         Fill="{StaticResource SuccessBrush}"
                         HorizontalAlignment="Center"
                         AutomationProperties.Name="休息引導節奏"
                         Margin="0,0,0,12"
                         Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="2" HorizontalAlignment="Stretch">
                <Button x:Name="CancelButton"
                        Content="結束休息"
                        ToolTip="結束目前的休息引導。"
                        FontSize="14"
                        Height="38"
                        Click="OnCancelButtonClick"
                        Background="{StaticResource DangerBrush}"
                        Foreground="{StaticResource ReminderTextBrush}"
                        BorderThickness="0"
                        Margin="0,0,0,8"
                        Visibility="Collapsed" />
                <Button x:Name="ActionButton"
                        ToolTip="開始休息並進入休息引導。"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Height="38"
                        Click="OnActionButtonClick"
                        Background="{StaticResource SuccessBrush}"
                        Foreground="{StaticResource ReminderTextBrush}"
                        BorderThickness="0"
                        Margin="0,0,0,8" />
                <Button x:Name="SnoozeButton"
                        ToolTip="延後這次提醒，稍後再提醒。"
                        FontSize="13"
                        Height="34"
                        Click="OnSnoozeButtonClick"
                        Background="{StaticResource ReminderNeutralButtonBrush}"
                        Foreground="{StaticResource ReminderTextBrush}"
                        BorderThickness="0"
                        Margin="0,0,0,6" />
                <Button x:Name="IgnoreButton"
                        Content="忽略"
                        ToolTip="忽略這次提醒，不開始休息。"
                        FontSize="13"
                        Height="34"
                        Click="OnIgnoreButtonClick"
                        Background="Transparent"
                        Foreground="{StaticResource ReminderTextBrush}"
                        BorderThickness="1"
                        BorderBrush="#66FFFFFF" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
