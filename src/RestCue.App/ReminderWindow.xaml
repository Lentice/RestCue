<Window x:Class="RestCue.App.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestCue Edge Reminder"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="220" Height="280"
        WindowStartupLocation="Manual"
        Background="#EE2B2B2B"
        Foreground="White"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True">
    <Border CornerRadius="8,0,0,8" Background="#EE2B2B2B" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Time for a break"
                       FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12" />

            <StackPanel Grid.Row="1" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="PhaseText"
                           Text="Look at something\n6 meters away."
                           FontSize="13"
                           TextAlignment="Center"
                           LineHeight="20"
                           LineStackingStrategy="BlockLineHeight"
                           Margin="0,0,0,12" />

                <TextBlock x:Name="CountdownText"
                           Text=""
                           FontSize="24" FontWeight="Light"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
            </StackPanel>

            <Button x:Name="ActionButton"
                    Grid.Row="2"
                    Content="Start 20s Break"
                    FontSize="14"
                    Height="36"
                    Width="160"
                    Click="OnActionButtonClick"
                    Cursor="Hand"
                    Background="#FF4CAF50"
                    Foreground="White"
                    BorderThickness="0" />
        </Grid>
    </Border>
</Window>
