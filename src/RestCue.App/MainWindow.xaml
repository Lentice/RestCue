<Window x:Class="RestCue.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestCue – Eye Break Reminder" Height="300" Width="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="RestCue" />
            <TextBlock Margin="0,4,0,0" Foreground="#666666"
                       Text="A gentle cue to rest your eyes." />
            <Border Margin="0,20,0,0" Padding="16" CornerRadius="8"
                    Background="#FFF3F4F6">
                <StackPanel>
                    <TextBlock Foreground="#666666" Text="目前狀態" />
                    <TextBlock x:Name="ActivityStatusText"
                               Margin="0,4,0,0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               AutomationProperties.Name="目前活動狀態"
                               Text="正在確認…" />
                    <TextBlock x:Name="CyclePhaseText"
                               Margin="0,4,0,0"
                               FontSize="14"
                               Foreground="#666666"
                               AutomationProperties.Name="週期階段"
                               Text="—" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
