<Window x:Class="RestCue.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RestCue.App"
        Title="RestCue – 護眼休息提醒" Height="320" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        local:WindowInteraction.CloseOnEscape="True">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="RestCue" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="溫和地提醒您讓眼睛休息。" />

            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabelStyle}"
                               Text="目前狀態" />
                    <TextBlock x:Name="ActivityStatusText"
                               Margin="0,6,0,0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               AutomationProperties.Name="目前活動狀態"
                               Text="正在確認…" />
                    <TextBlock x:Name="CyclePhaseText"
                               Margin="0,6,0,0"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               AutomationProperties.Name="週期階段"
                               Text="—" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FieldHintStyle}"
                       Margin="0,12,0,0"
                       Text="RestCue 在系統列常駐執行，關閉此視窗不會結束程式。" />
        </StackPanel>
    </Grid>
</Window>
