<Window x:Class="RestCue.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RestCue.App"
        Title="RestCue – 護眼休息提醒" Height="480" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        local:WindowInteraction.CloseOnEscape="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="檔案">
                <MenuItem Header="設定" Click="OnSettingsClick" />
                <MenuItem Header="關於與隱私" Click="OnAboutClick" />
                <Separator />
                <MenuItem Header="結束 RestCue" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="檢視">
                <MenuItem Header="今日統計" Click="OnStatisticsClick" />
                <MenuItem Header="資料透明檢視" Click="OnDataTransparencyClick" />
                <MenuItem Header="匯出／清除資料" Click="OnDataManagementClick" />
            </MenuItem>
            <MenuItem x:Name="OperationsMenu" Header="操作">
                <MenuItem x:Name="PauseSubmenu" Header="暫停提醒">
                    <MenuItem x:Name="PauseFor15MenuItem" Click="OnPauseFor15Click" />
                    <MenuItem x:Name="PauseFor30MenuItem" Click="OnPauseFor30Click" />
                    <MenuItem x:Name="PauseFor60MenuItem" Click="OnPauseFor60Click" />
                    <Separator />
                    <MenuItem Header="直到手動恢復" Click="OnPauseManualClick" />
                </MenuItem>
                <MenuItem x:Name="ResumeMenuItem" Header="繼續提醒" Click="OnResumeClick"
                          Visibility="Collapsed" />
                <MenuItem x:Name="FocusMenuItem" Header="專注模式" Click="OnToggleFocusClick" />
                <MenuItem x:Name="DisableMenuItem" Header="停用提醒" Click="OnToggleDisableClick" />
                <MenuItem x:Name="BreakNowMenuItem" Header="立即休息" Click="OnBreakNowClick" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="28,8,28,24">
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="RestCue" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="溫和地提醒您讓眼睛休息。" />

                <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabelStyle}"
                                   Text="目前狀態" />
                        <TextBlock x:Name="ActivityStatusText"
                                   Margin="0,6,0,0"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   AutomationProperties.Name="目前活動狀態"
                                   Text="正在確認…" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse x:Name="StatusDot"
                                     Width="7" Height="7"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="CyclePhaseText"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       AutomationProperties.Name="週期階段"
                                       Text="—" />
                        </StackPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource MetricLabelStyle}"
                                           Text="本次有效工作" />
                                <TextBlock x:Name="EffectiveWorkTimeText"
                                           Margin="0,5,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           AutomationProperties.Name="本次有效工作時間"
                                           Text="0 分鐘" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource MetricLabelStyle}"
                                           Text="下個休息需求" />
                                <TextBlock x:Name="NextRestTimeText"
                                           Margin="0,5,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           AutomationProperties.Name="下個休息需求時間"
                                           Text="—" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <WrapPanel Margin="0,20,0,0" HorizontalAlignment="Center">
                    <Button x:Name="BreakNowButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="88"
                            Content="立即休息"
                            ToolTip="立即開始一段休息引導。"
                            Click="OnBreakNowClick" />
                    <Button x:Name="PauseResumeButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="88"
                            Content="暫停"
                            ToolTip="暫停提醒與工作時間累積；再次點擊可繼續。"
                            Click="OnTogglePauseClick" Margin="8,0,0,0" />
                    <Button x:Name="FocusButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="88"
                            Content="專注模式"
                            ToolTip="暫時停止主動提醒，但仍持續累積工作時間與休息需求；結束後恢復提醒。"
                            Click="OnToggleFocusClick" Margin="8,0,0,0" />
                    <Button x:Name="DisableButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="88"
                            Content="停用提醒"
                            ToolTip="停用提醒功能；再次點擊可重新啟用。"
                            Click="OnToggleDisableClick" Margin="8,0,0,0" />
                </WrapPanel>

                <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="設定"
                            ToolTip="調整提醒節奏、休息引導、隱私與啟動選項。"
                            Click="OnSettingsClick" MinWidth="88" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="今日統計"
                            ToolTip="查看今天的工作、休息與提醒統計。"
                            Click="OnStatisticsClick" Margin="8,0,0,0"
                            MinWidth="88" />
                </WrapPanel>

                <TextBlock Style="{StaticResource FieldHintStyle}"
                           Margin="0,16,0,0"
                           TextAlignment="Center"
                           Text="RestCue 在系統列常駐執行，關閉此視窗不會結束程式。" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
