<Window x:Class="RestCue.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestCue – 關於與隱私" Height="440" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <ScrollViewer Margin="24" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="RestCue" />
            <TextBlock x:Name="VersionText" Margin="0,4,0,0"
                       Foreground="#666666" FontSize="13" />

            <Border Padding="16" CornerRadius="8"
                    Background="#FFF3F4F6" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold"
                               Text="關於 RestCue" />
                    <TextBlock Margin="0,8,0,0" Foreground="#333333"
                               TextWrapping="Wrap" FontSize="13"
                               Text="RestCue 是 Windows 用眼的休息提醒工具，以低干擾的方式定期提醒您讓眼睛休息。&#x0a;&#x0a;RestCue 是休息提醒工具，不是醫療器材，也不提供診斷或治療建議。" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8"
                    Background="#FFF3F4F6" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold"
                               Text="隱私說明" />
                    <TextBlock Margin="0,8,0,0" Foreground="#333333"
                               TextWrapping="Wrap" FontSize="13">
                        <Run Text="RestCue 預設只在本機處理與保存資料。" />
                        <LineBreak /><LineBreak />
                        <Run Text="不蒐集鍵盤輸入內容、剪貼簿、畫面、視窗標題、網址或文件名稱。前景程式名稱的統計記錄預設關閉，僅在使用者明確啟用後保存。日誌不會意外包含上述資料。" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8"
                    Background="#FFF3F4F6" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold"
                               Text="技術資訊" />
                    <TextBlock x:Name="TechInfoText" Margin="0,8,0,0"
                               Foreground="#666666" FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
