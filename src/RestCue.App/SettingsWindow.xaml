<Window x:Class="RestCue.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestCue – 設定" Height="640" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="設定" />
            <TextBlock x:Name="StatusMessage" Margin="0,4,0,12"
                       Foreground="#CC0000" FontSize="13"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <!-- Timing Section -->
            <Border Padding="16" CornerRadius="8" Background="#FFF3F4F6">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold"
                               Text="計時設定" />

                    <TextBlock Margin="0,12,0,2" Foreground="#666666"
                               Text="工作間隔（分鐘） 10–60" />
                    <TextBox x:Name="WorkIntervalBox" Text="20"
                             MaxLength="3" />
                    <TextBlock x:Name="WorkIntervalError"
                               Foreground="#CC0000" FontSize="11"
                               Visibility="Collapsed" />

                    <TextBlock Margin="0,8,0,2" Foreground="#666666"
                               Text="自然停頓門檻（秒） 2–30" />
                    <TextBox x:Name="NaturalPauseBox" Text="5"
                             MaxLength="2" />
                    <TextBlock x:Name="NaturalPauseError"
                               Foreground="#CC0000" FontSize="11"
                               Visibility="Collapsed" />

                    <TextBlock Margin="0,8,0,2" Foreground="#666666"
                               Text="最長提醒等待（分鐘） 0–10" />
                    <TextBox x:Name="MaxReminderWaitBox" Text="3"
                             MaxLength="2" />
                    <TextBlock x:Name="MaxReminderWaitError"
                               Foreground="#CC0000" FontSize="11"
                               Visibility="Collapsed" />

                    <TextBlock Margin="0,8,0,2" Foreground="#666666"
                               Text="離開判斷時間（分鐘） 1–10" />
                    <TextBox x:Name="IdleThresholdBox" Text="2"
                             MaxLength="2" />
                    <TextBlock x:Name="IdleThresholdError"
                               Foreground="#CC0000" FontSize="11"
                               Visibility="Collapsed" />

                    <TextBlock Margin="0,8,0,2" Foreground="#666666"
                               Text="被動休息門檻（秒） 10–120" />
                    <TextBox x:Name="PassiveBreakBox" Text="20"
                             MaxLength="3" />
                    <TextBlock x:Name="PassiveBreakError"
                               Foreground="#CC0000" FontSize="11"
                               Visibility="Collapsed" />

                    <TextBlock Margin="0,8,0,2" Foreground="#666666"
                               Text="休息長度（秒） 10–60" />
                    <TextBox x:Name="BreakDurationBox" Text="20"
                             MaxLength="2" />
                    <TextBlock x:Name="BreakDurationError"
                               Foreground="#CC0000" FontSize="11"
                               Visibility="Collapsed" />

                    <TextBlock Margin="0,8,0,2" Foreground="#666666"
                               Text="延後長度（分鐘） 1–30" />
                    <TextBox x:Name="SnoozeDurationBox" Text="5"
                             MaxLength="2" />
                    <TextBlock x:Name="SnoozeDurationError"
                               Foreground="#CC0000" FontSize="11"
                               Visibility="Collapsed" />

                    <TextBlock Margin="0,8,0,2" Foreground="#666666"
                               Text="提醒顯示時間（秒） 5–120" />
                    <TextBox x:Name="ReminderDisplayBox" Text="30"
                             MaxLength="3" />
                    <TextBlock x:Name="ReminderDisplayError"
                               Foreground="#CC0000" FontSize="11"
                               Visibility="Collapsed" />

                    <TextBlock Margin="0,8,0,2" Foreground="#666666"
                               Text="提醒重試冷卻（分鐘） 1–60" />
                    <TextBox x:Name="RetryCooldownBox" Text="20"
                             MaxLength="2" />
                    <TextBlock x:Name="RetryCooldownError"
                               Foreground="#CC0000" FontSize="11"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Debt Thresholds Section -->
            <Border Margin="0,12,0,0" Padding="16" CornerRadius="8"
                    Background="#FFF3F4F6">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold"
                               Text="休息債務門檻（分鐘）" />

                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Foreground="#666666" Text="Level 2" />
                        <TextBox x:Name="DebtLevel2Box" Grid.Row="0"
                                 Grid.Column="1" Text="35" MaxLength="3"
                                 Margin="4,0,0,4" />
                        <TextBlock x:Name="DebtLevel2Error"
                                   Grid.Row="0" Grid.Column="2"
                                   Foreground="#CC0000" FontSize="11"
                                   Visibility="Collapsed" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Foreground="#666666" Text="Level 3" />
                        <TextBox x:Name="DebtLevel3Box" Grid.Row="1"
                                 Grid.Column="1" Text="45" MaxLength="3"
                                 Margin="4,0,0,4" />
                        <TextBlock x:Name="DebtLevel3Error"
                                   Grid.Row="1" Grid.Column="2"
                                   Foreground="#CC0000" FontSize="11"
                                   Visibility="Collapsed" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Foreground="#666666" Text="Level 4" />
                        <TextBox x:Name="DebtLevel4Box" Grid.Row="2"
                                 Grid.Column="1" Text="60" MaxLength="3"
                                 Margin="4,0,0,0" />
                        <TextBlock x:Name="DebtLevel4Error"
                                   Grid.Row="2" Grid.Column="2"
                                   Foreground="#CC0000" FontSize="11"
                                   Visibility="Collapsed" />
                    </Grid>

                    <TextBlock x:Name="DebtOrderError"
                               Foreground="#CC0000" FontSize="11"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Visual & Guide Section -->
            <Border Margin="0,12,0,0" Padding="16" CornerRadius="8"
                    Background="#FFF3F4F6">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold"
                               Text="視覺與引導設定" />

                    <TextBlock Margin="0,12,0,2" Foreground="#666666"
                               Text="提醒透明度（20% – 100%）" />
                    <Slider x:Name="ReminderOpacitySlider"
                            Minimum="0.2" Maximum="1.0"
                            LargeChange="0.1" SmallChange="0.05"
                            Value="0.7" TickFrequency="0.1"
                            IsSnapToTickEnabled="True"
                            Margin="0,4,0,0" />
                    <TextBlock x:Name="ReminderOpacityText"
                               Foreground="#666666" FontSize="11"
                               Text="70%" />

                    <TextBlock Margin="0,12,0,4" Foreground="#666666"
                               Text="休息引導模式" />
                    <RadioButton x:Name="GuideCueRadio" GroupName="GuideMode"
                                 Content="提示音 + 視覺引導" IsChecked="True" />
                    <RadioButton x:Name="GuideVoiceRadio" GroupName="GuideMode"
                                 Content="語音 + 視覺引導" Margin="0,4,0,0" />
                    <RadioButton x:Name="GuideVisualRadio" GroupName="GuideMode"
                                 Content="純視覺引導" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Privacy Section -->
            <Border Margin="0,12,0,0" Padding="16" CornerRadius="8"
                    Background="#FFF3F4F6">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold"
                               Text="隱私設定" />

                    <CheckBox x:Name="CollectProcessNamesCheck"
                              Margin="0,12,0,0"
                              Content="蒐集前景程式名稱（預設關閉）" />
                    <TextBlock Foreground="#999999" FontSize="11"
                               TextWrapping="Wrap"
                               Text="啟用後將記錄目前使用中程式的名稱，僅儲存於本機，不會對外傳送。預設為關閉。" />
                </StackPanel>
            </Border>

            <!-- System Section -->
            <Border Margin="0,12,0,0" Padding="16" CornerRadius="8"
                    Background="#FFF3F4F6">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold"
                               Text="系統設定" />

                    <CheckBox x:Name="StartupCheck"
                              Margin="0,12,0,0"
                              Content="開機時自動啟動 RestCue" />
                    <TextBlock x:Name="StartupDiagnostics"
                               Foreground="#CC0000" FontSize="11"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Save Button -->
            <Button x:Name="SaveButton" Content="儲存設定"
                    Margin="0,16,0,0" Padding="12,8"
                    HorizontalAlignment="Center"
                    Click="OnSaveClick" />

        </StackPanel>
    </ScrollViewer>
</Window>
