<Window x:Class="RestCue.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RestCue.App"
        Title="RestCue – 設定"
        Height="700" Width="820"
        MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        local:WindowInteraction.CloseOnEscape="True">
    <Window.Resources>
        <Style x:Key="SettingsGroupStyle" TargetType="Border"
               BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SettingsFieldStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,16,2" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="24,20,24,16"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource DividerBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource WindowTitleStyle}" Text="設定" />
                    <TextBlock Style="{StaticResource WindowSubtitleStyle}"
                               Margin="0,3,0,0"
                               Text="調整提醒節奏、休息引導與隱私選項。" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="變更會儲存在此裝置" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Padding="24,18,16,18"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="StatusBanner"
                        Style="{StaticResource SettingsGroupStyle}"
                        Visibility="Collapsed"
                        AutomationProperties.LiveSetting="Polite">
                    <TextBlock x:Name="StatusMessage"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource DangerTextBrush}" />
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                           Text="提醒節奏" />
                                <TextBlock Style="{StaticResource FieldHintStyle}"
                                           Margin="0,3,0,10"
                                           Text="設定工作、停頓與提醒的時間。所有數值會在儲存前驗證。" />

                                <UniformGrid Columns="2">
                                    <StackPanel Style="{StaticResource SettingsFieldStyle}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="工作間隔（分鐘，10–60）" />
                                        <TextBox x:Name="WorkIntervalBox" Text="20" MaxLength="3"
                                                 Style="{StaticResource NumericFieldStyle}"
                                                 AutomationProperties.Name="工作間隔，分鐘" />
                                        <TextBlock x:Name="WorkIntervalError" Style="{StaticResource ErrorTextStyle}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SettingsFieldStyle}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="自然停頓門檻（秒，2–30）" />
                                        <TextBox x:Name="NaturalPauseBox" Text="5" MaxLength="2"
                                                 Style="{StaticResource NumericFieldStyle}"
                                                 AutomationProperties.Name="自然停頓門檻，秒" />
                                        <TextBlock x:Name="NaturalPauseError" Style="{StaticResource ErrorTextStyle}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SettingsFieldStyle}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="最長提醒等待（分鐘，0–10）" />
                                        <TextBox x:Name="MaxReminderWaitBox" Text="3" MaxLength="2"
                                                 Style="{StaticResource NumericFieldStyle}"
                                                 AutomationProperties.Name="最長提醒等待，分鐘" />
                                        <TextBlock x:Name="MaxReminderWaitError" Style="{StaticResource ErrorTextStyle}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SettingsFieldStyle}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="離開判斷時間（分鐘，1–10）" />
                                        <TextBox x:Name="IdleThresholdBox" Text="2" MaxLength="2"
                                                 Style="{StaticResource NumericFieldStyle}"
                                                 AutomationProperties.Name="離開判斷時間，分鐘" />
                                        <TextBlock x:Name="IdleThresholdError" Style="{StaticResource ErrorTextStyle}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SettingsFieldStyle}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="被動休息門檻（秒，10–120）" />
                                        <TextBox x:Name="PassiveBreakBox" Text="20" MaxLength="3"
                                                 Style="{StaticResource NumericFieldStyle}"
                                                 AutomationProperties.Name="被動休息門檻，秒" />
                                        <TextBlock x:Name="PassiveBreakError" Style="{StaticResource ErrorTextStyle}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SettingsFieldStyle}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="休息長度（秒，10–60）" />
                                        <TextBox x:Name="BreakDurationBox" Text="20" MaxLength="2"
                                                 Style="{StaticResource NumericFieldStyle}"
                                                 AutomationProperties.Name="休息長度，秒" />
                                        <TextBlock x:Name="BreakDurationError" Style="{StaticResource ErrorTextStyle}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SettingsFieldStyle}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="延後長度（分鐘，1–30）" />
                                        <TextBox x:Name="SnoozeDurationBox" Text="5" MaxLength="2"
                                                 Style="{StaticResource NumericFieldStyle}"
                                                 AutomationProperties.Name="延後長度，分鐘" />
                                        <TextBlock x:Name="SnoozeDurationError" Style="{StaticResource ErrorTextStyle}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SettingsFieldStyle}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="提醒顯示時間（秒，5–120）" />
                                        <TextBox x:Name="ReminderDisplayBox" Text="30" MaxLength="3"
                                                 Style="{StaticResource NumericFieldStyle}"
                                                 AutomationProperties.Name="提醒顯示時間，秒" />
                                        <TextBlock x:Name="ReminderDisplayError" Style="{StaticResource ErrorTextStyle}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SettingsFieldStyle}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="提醒重試冷卻（分鐘，1–60）" />
                                        <TextBox x:Name="RetryCooldownBox" Text="20" MaxLength="2"
                                                 Style="{StaticResource NumericFieldStyle}"
                                                 AutomationProperties.Name="提醒重試冷卻，分鐘" />
                                        <TextBlock x:Name="RetryCooldownError" Style="{StaticResource ErrorTextStyle}" Visibility="Collapsed" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="休息債務門檻" />
                                <TextBlock Style="{StaticResource FieldHintStyle}"
                                           Margin="0,3,0,12"
                                           Text="累積未休息時間達到門檻時，系統列圖示會升級。數值須由小到大。" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Style="{StaticResource SettingsFieldStyle}">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Level 2（分鐘）" />
                                        <TextBox x:Name="DebtLevel2Box" Style="{StaticResource NumericFieldStyle}"
                                                 Text="35" MaxLength="3" Margin="0,5,0,0"
                                                 AutomationProperties.Name="債務門檻 Level 2，分鐘" />
                                        <TextBlock x:Name="DebtLevel2Error" Style="{StaticResource ErrorTextStyle}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Style="{StaticResource SettingsFieldStyle}">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Level 3（分鐘）" />
                                        <TextBox x:Name="DebtLevel3Box" Style="{StaticResource NumericFieldStyle}"
                                                 Text="45" MaxLength="3" Margin="0,5,0,0"
                                                 AutomationProperties.Name="債務門檻 Level 3，分鐘" />
                                        <TextBlock x:Name="DebtLevel3Error" Style="{StaticResource ErrorTextStyle}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Level 4（分鐘）" />
                                        <TextBox x:Name="DebtLevel4Box" Style="{StaticResource NumericFieldStyle}"
                                                 Text="60" MaxLength="3" Margin="0,5,0,0"
                                                 AutomationProperties.Name="債務門檻 Level 4，分鐘" />
                                        <TextBlock x:Name="DebtLevel4Error" Style="{StaticResource ErrorTextStyle}" Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="DebtOrderError"
                                           Style="{StaticResource ErrorTextStyle}"
                                           Margin="0,8,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="應用程式規則" />
                                <TextBlock Style="{StaticResource FieldHintStyle}"
                                           Margin="0,3,0,10"
                                           Text="設定個別應用程式的提醒行為。規則會儲存在此裝置。" />

                                <StackPanel x:Name="RuleListStack" />

                                <Border Background="{StaticResource InputBackgroundBrush}"
                                        BorderBrush="{StaticResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Padding="12"
                                        Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="新增規則" Margin="0,0,0,4" />
                                        <TextBox x:Name="AddRuleProcessBox"
                                                 Style="{StaticResource NumericFieldStyle}"
                                                 Width="180"
                                                 MaxLength="64"
                                                 AutomationProperties.Name="處理程序名稱"
                                                 Text="zoom" />
                                        <TextBlock Style="{StaticResource FieldHintStyle}" Text="處理程序名稱（不含 .exe）" Margin="0,2,0,8" />

                                        <StackPanel Margin="0,0,0,8">
                                            <RadioButton x:Name="AddRuleTrayRadio" GroupName="AddRuleType"
                                                         Content="僅系統列" IsChecked="True"
                                                         Checked="OnAddRuleTypeChanged" />
                                            <RadioButton x:Name="AddRuleNormalRadio" GroupName="AddRuleType"
                                                         Content="一般" Margin="0,4,0,0"
                                                         Checked="OnAddRuleTypeChanged" />
                                            <RadioButton x:Name="AddRuleSilentRadio" GroupName="AddRuleType"
                                                         Content="無聲" Margin="0,4,0,0"
                                                         Checked="OnAddRuleTypeChanged" />
                                            <RadioButton x:Name="AddRuleCustomRadio" GroupName="AddRuleType"
                                                         Content="自訂間隔" Margin="0,4,0,0"
                                                         Checked="OnAddRuleTypeChanged" />
                                        </StackPanel>

                                        <StackPanel x:Name="CustomIntervalPanel"
                                                    Visibility="Collapsed"
                                                    Margin="0,0,0,8">
                                            <TextBox x:Name="AddRuleIntervalBox"
                                                     Style="{StaticResource NumericFieldStyle}"
                                                     Width="88"
                                                     MaxLength="3"
                                                     Text="30"
                                                     AutomationProperties.Name="自訂間隔，分鐘" />
                                            <TextBlock Style="{StaticResource FieldHintStyle}" Text="分鐘（1–120）" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="AddRuleButton"
                                                    Content="新增"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    MinWidth="80"
                                                    Click="OnAddRuleClick" />
                                            <Button x:Name="CancelEditButton"
                                                    Content="取消編輯"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    MinWidth="80"
                                                    Margin="8,0,0,0"
                                                    Visibility="Collapsed"
                                                    Click="OnCancelEditClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="提醒呈現" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="提醒透明度（20%–100%）" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="ReminderOpacitySlider"
                                            Minimum="0.2" Maximum="1.0"
                                            LargeChange="0.1" SmallChange="0.05"
                                            Value="0.7" TickFrequency="0.1"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="提醒透明度" />
                                    <TextBlock x:Name="ReminderOpacityText" Grid.Column="1"
                                               Style="{StaticResource KeyValueValueStyle}"
                                               MinWidth="44" TextAlignment="Right"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="70%" />
                                </Grid>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,6" Text="休息引導模式" />
                                <RadioButton x:Name="GuideCueRadio" GroupName="GuideMode"
                                             Content="提示音 + 視覺引導" IsChecked="True" />
                                <RadioButton x:Name="GuideVoiceRadio" GroupName="GuideMode"
                                             Content="語音 + 視覺引導" Margin="0,6,0,0" />
                                <RadioButton x:Name="GuideVisualRadio" GroupName="GuideMode"
                                             Content="純視覺引導" Margin="0,6,0,0" />
                                <CheckBox x:Name="ReduceMotionCheck"
                                          Margin="0,12,0,0"
                                          Content="減少動畫效果" />
                                <TextBlock Style="{StaticResource FieldHintStyle}"
                                           Text="啟用後，休息時的視覺引導僅顯示階段文字，不包含連續動畫。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="隱私" />
                                <CheckBox x:Name="CollectProcessNamesCheck"
                                          Margin="0,12,0,0"
                                          Content="記錄前景程式名稱" />
                                <TextBlock Style="{StaticResource FieldHintStyle}"
                                           Text="選用，預設關閉。只記錄 process name；不含視窗標題、網址或文件名稱。資料僅留在本機。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Windows" />
                                <CheckBox x:Name="StartupCheck"
                                          Margin="0,12,0,0"
                                          Content="登入後自動啟動 RestCue" />
                                <TextBlock x:Name="StartupDiagnostics"
                                           Style="{StaticResource ErrorTextStyle}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="24,12"
                Background="{StaticResource SurfaceBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource DividerBrush}">
            <Grid>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="部分變更會在下次啟動時生效" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="88" Margin="0,0,8,0"
                            IsCancel="True"
                            Click="OnCloseClick" />
                    <Button x:Name="SaveButton"
                            Content="儲存設定"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="110"
                            IsDefault="True"
                            Click="OnSaveClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
