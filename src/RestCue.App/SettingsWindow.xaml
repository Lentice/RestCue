<Window x:Class="RestCue.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RestCue.App"
        Title="RestCue – 設定" Height="660" Width="540"
        MinHeight="400" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        local:WindowInteraction.CloseOnEscape="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="20,20,20,12">
            <TextBlock Style="{StaticResource WindowTitleStyle}" Text="設定" />
            <Border x:Name="StatusBanner" Style="{StaticResource CardStyle}"
                    Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="StatusMessage"
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{StaticResource DangerTextBrush}" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="20,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Timing Section -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="計時設定" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="工作間隔（分鐘，10–60）" />
                        <TextBox x:Name="WorkIntervalBox" Text="20" MaxLength="3"
                                 Style="{StaticResource NumericFieldStyle}"
                                 AutomationProperties.Name="工作間隔，分鐘" />
                        <TextBlock x:Name="WorkIntervalError"
                                   Style="{StaticResource ErrorTextStyle}"
                                   Visibility="Collapsed" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="自然停頓門檻（秒，2–30）" />
                        <TextBox x:Name="NaturalPauseBox" Text="5" MaxLength="2"
                                 Style="{StaticResource NumericFieldStyle}"
                                 AutomationProperties.Name="自然停頓門檻，秒" />
                        <TextBlock x:Name="NaturalPauseError"
                                   Style="{StaticResource ErrorTextStyle}"
                                   Visibility="Collapsed" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="最長提醒等待（分鐘，0–10）" />
                        <TextBox x:Name="MaxReminderWaitBox" Text="3" MaxLength="2"
                                 Style="{StaticResource NumericFieldStyle}"
                                 AutomationProperties.Name="最長提醒等待，分鐘" />
                        <TextBlock x:Name="MaxReminderWaitError"
                                   Style="{StaticResource ErrorTextStyle}"
                                   Visibility="Collapsed" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="離開判斷時間（分鐘，1–10）" />
                        <TextBox x:Name="IdleThresholdBox" Text="2" MaxLength="2"
                                 Style="{StaticResource NumericFieldStyle}"
                                 AutomationProperties.Name="離開判斷時間，分鐘" />
                        <TextBlock x:Name="IdleThresholdError"
                                   Style="{StaticResource ErrorTextStyle}"
                                   Visibility="Collapsed" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="被動休息門檻（秒，10–120）" />
                        <TextBox x:Name="PassiveBreakBox" Text="20" MaxLength="3"
                                 Style="{StaticResource NumericFieldStyle}"
                                 AutomationProperties.Name="被動休息門檻，秒" />
                        <TextBlock x:Name="PassiveBreakError"
                                   Style="{StaticResource ErrorTextStyle}"
                                   Visibility="Collapsed" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="休息長度（秒，10–60）" />
                        <TextBox x:Name="BreakDurationBox" Text="20" MaxLength="2"
                                 Style="{StaticResource NumericFieldStyle}"
                                 AutomationProperties.Name="休息長度，秒" />
                        <TextBlock x:Name="BreakDurationError"
                                   Style="{StaticResource ErrorTextStyle}"
                                   Visibility="Collapsed" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="延後長度（分鐘，1–30）" />
                        <TextBox x:Name="SnoozeDurationBox" Text="5" MaxLength="2"
                                 Style="{StaticResource NumericFieldStyle}"
                                 AutomationProperties.Name="延後長度，分鐘" />
                        <TextBlock x:Name="SnoozeDurationError"
                                   Style="{StaticResource ErrorTextStyle}"
                                   Visibility="Collapsed" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="提醒顯示時間（秒，5–120）" />
                        <TextBox x:Name="ReminderDisplayBox" Text="30" MaxLength="3"
                                 Style="{StaticResource NumericFieldStyle}"
                                 AutomationProperties.Name="提醒顯示時間，秒" />
                        <TextBlock x:Name="ReminderDisplayError"
                                   Style="{StaticResource ErrorTextStyle}"
                                   Visibility="Collapsed" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="提醒重試冷卻（分鐘，1–60）" />
                        <TextBox x:Name="RetryCooldownBox" Text="20" MaxLength="2"
                                 Style="{StaticResource NumericFieldStyle}"
                                 AutomationProperties.Name="提醒重試冷卻，分鐘" />
                        <TextBlock x:Name="RetryCooldownError"
                                   Style="{StaticResource ErrorTextStyle}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Debt Thresholds Section -->
                <Border Style="{StaticResource StackedCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="休息債務門檻（分鐘）" />
                        <TextBlock Style="{StaticResource FieldHintStyle}"
                                   Text="累積未休息時間達到各門檻時，系統列圖示會升級到對應等級。數值需由小到大遞增。" />

                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource MetricLabelStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,6" Text="Level 2" />
                            <TextBox x:Name="DebtLevel2Box" Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource NumericFieldStyle}"
                                     Text="35" MaxLength="3" Margin="0,0,0,6"
                                     AutomationProperties.Name="債務門檻 Level 2，分鐘" />
                            <TextBlock x:Name="DebtLevel2Error" Grid.Row="0" Grid.Column="2"
                                       Style="{StaticResource ErrorTextStyle}"
                                       VerticalAlignment="Center" Margin="12,0,0,6"
                                       Visibility="Collapsed" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource MetricLabelStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,6" Text="Level 3" />
                            <TextBox x:Name="DebtLevel3Box" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource NumericFieldStyle}"
                                     Text="45" MaxLength="3" Margin="0,0,0,6"
                                     AutomationProperties.Name="債務門檻 Level 3，分鐘" />
                            <TextBlock x:Name="DebtLevel3Error" Grid.Row="1" Grid.Column="2"
                                       Style="{StaticResource ErrorTextStyle}"
                                       VerticalAlignment="Center" Margin="12,0,0,6"
                                       Visibility="Collapsed" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Style="{StaticResource MetricLabelStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" Text="Level 4" />
                            <TextBox x:Name="DebtLevel4Box" Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource NumericFieldStyle}"
                                     Text="60" MaxLength="3"
                                     AutomationProperties.Name="債務門檻 Level 4，分鐘" />
                            <TextBlock x:Name="DebtLevel4Error" Grid.Row="2" Grid.Column="2"
                                       Style="{StaticResource ErrorTextStyle}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="Collapsed" />
                        </Grid>

                        <TextBlock x:Name="DebtOrderError"
                                   Style="{StaticResource ErrorTextStyle}"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Visual & Guide Section -->
                <Border Style="{StaticResource StackedCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="視覺與引導設定" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="提醒透明度（20% – 100%）" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="ReminderOpacitySlider" Grid.Column="0"
                                    Minimum="0.2" Maximum="1.0"
                                    LargeChange="0.1" SmallChange="0.05"
                                    Value="0.7" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="提醒透明度" />
                            <TextBlock x:Name="ReminderOpacityText" Grid.Column="1"
                                       Style="{StaticResource KeyValueValueStyle}"
                                       MinWidth="44" TextAlignment="Right"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="70%" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="休息引導模式" />
                        <RadioButton x:Name="GuideCueRadio" GroupName="GuideMode"
                                     Content="提示音 + 視覺引導" IsChecked="True" />
                        <RadioButton x:Name="GuideVoiceRadio" GroupName="GuideMode"
                                     Content="語音 + 視覺引導" Margin="0,6,0,0" />
                        <RadioButton x:Name="GuideVisualRadio" GroupName="GuideMode"
                                     Content="純視覺引導" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Privacy Section -->
                <Border Style="{StaticResource StackedCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="隱私設定" />
                        <CheckBox x:Name="CollectProcessNamesCheck"
                                  Margin="0,12,0,0"
                                  Content="蒐集前景程式名稱（預設關閉）" />
                        <TextBlock Style="{StaticResource FieldHintStyle}"
                                   Text="啟用後將記錄目前使用中程式的名稱，僅儲存於本機，不會對外傳送。預設為關閉。" />
                    </StackPanel>
                </Border>

                <!-- System Section -->
                <Border Style="{StaticResource StackedCardStyle}" Margin="0,12,0,20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="系統設定" />
                        <CheckBox x:Name="StartupCheck"
                                  Margin="0,12,0,0"
                                  Content="開機時自動啟動 RestCue" />
                        <TextBlock x:Name="StartupDiagnostics"
                                   Style="{StaticResource ErrorTextStyle}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Sticky action bar: Save stays reachable without scrolling the form. -->
        <Border Grid.Row="2" Padding="20,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource DividerBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="關閉"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="88" Margin="0,0,8,0"
                        IsCancel="True"
                        Click="OnCloseClick" />
                <Button x:Name="SaveButton" Content="儲存設定"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="110"
                        IsDefault="True"
                        Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
