<Window x:Class="RestCue.App.DataManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestCue – 匯出與清除資料" Height="400" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True">
    <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="匯出與清除資料" />
            <TextBlock Margin="0,4,0,16" Foreground="#666666" FontSize="13"
                       Text="匯出或清除本機資料。清除與重設不可復原。" />

            <Border Padding="16" CornerRadius="8" Background="#FFF3F4F6">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="匯出使用記錄" />
                    <TextBlock Margin="0,4,0,8" Foreground="#666666" FontSize="12"
                               Text="匯出 usage_events 到 JSON 檔，僅含允許的欄位。" />
                    <Button x:Name="ExportButton" Content="選擇目的地並匯出…"
                            Click="ExportButton_Click"
                            HorizontalAlignment="Left" Padding="12,6" />
                    <TextBlock x:Name="ExportStatusText" Margin="0,4,0,0"
                               Foreground="#666666" FontSize="12" />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Padding="16" CornerRadius="8"
                    Background="#FFF3F4F6">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="清除使用記錄" />
                    <TextBlock Margin="0,4,0,8" Foreground="#CC0000" FontSize="12"
                               Text="刪除所有 usage_events。設定不受影響。此操作不可復原。" />
                    <Button x:Name="ClearHistoryButton" Content="清除使用記錄…"
                            Click="ClearHistoryButton_Click"
                            HorizontalAlignment="Left" Padding="12,6" />
                    <TextBlock x:Name="ClearHistoryStatusText" Margin="0,4,0,0"
                               Foreground="#666666" FontSize="12" />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Padding="16" CornerRadius="8"
                    Background="#FFF3F4F6">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="重設設定" />
                    <TextBlock Margin="0,4,0,8" Foreground="#CC0000" FontSize="12"
                               Text="恢復所有設定為預設值（前景程式名稱蒐集將關閉）。使用記錄不受影響。此操作不可復原。" />
                    <Button x:Name="ResetSettingsButton" Content="重設設定…"
                            Click="ResetSettingsButton_Click"
                            HorizontalAlignment="Left" Padding="12,6" />
                    <TextBlock x:Name="ResetSettingsStatusText" Margin="0,4,0,0"
                               Foreground="#666666" FontSize="12" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
