<Window x:Class="RestCue.App.DataManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RestCue.App"
        Title="RestCue – 匯出與清除資料" Height="480" Width="480"
        MinHeight="320" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        local:WindowInteraction.CloseOnEscape="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="20,20,20,0">
            <TextBlock Style="{StaticResource WindowTitleStyle}" Text="匯出與清除資料" />
            <TextBlock Style="{StaticResource WindowSubtitleStyle}"
                       Text="匯出或清除本機資料。清除與重設不可復原。" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="20,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="匯出使用記錄" />
                        <TextBlock Style="{StaticResource FieldHintStyle}"
                                   Margin="0,4,0,10"
                                   Text="匯出 usage_events 到 JSON 檔，僅含允許的欄位。" />
                        <Button x:Name="ExportButton" Content="選擇目的地並匯出…"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="ExportButton_Click" />
                        <TextBlock x:Name="ExportStatusText"
                                   Style="{StaticResource FieldHintStyle}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StackedCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="清除使用記錄" />
                        <TextBlock Style="{StaticResource FieldHintStyle}"
                                   Margin="0,4,0,10"
                                   Foreground="{StaticResource DangerTextBrush}"
                                   Text="刪除所有 usage_events。設定不受影響。此操作不可復原。" />
                        <Button x:Name="ClearHistoryButton" Content="清除使用記錄…"
                                Style="{StaticResource DangerButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="ClearHistoryButton_Click" />
                        <TextBlock x:Name="ClearHistoryStatusText"
                                   Style="{StaticResource FieldHintStyle}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StackedCardStyle}" Margin="0,12,0,20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="重設設定" />
                        <TextBlock Style="{StaticResource FieldHintStyle}"
                                   Margin="0,4,0,10"
                                   Foreground="{StaticResource DangerTextBrush}"
                                   Text="恢復所有設定為預設值（前景程式名稱蒐集將關閉）。使用記錄不受影響。此操作不可復原。" />
                        <Button x:Name="ResetSettingsButton" Content="重設設定…"
                                Style="{StaticResource DangerButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="ResetSettingsButton_Click" />
                        <TextBlock x:Name="ResetSettingsStatusText"
                                   Style="{StaticResource FieldHintStyle}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="20,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource DividerBrush}">
            <Button Content="關閉"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Right"
                    MinWidth="88"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </Border>
    </Grid>
</Window>
