<Window x:Class="RestCue.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestCue 通知"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="320"
        WindowStartupLocation="Manual"
        Background="Transparent"
        Opacity="0.92"
        IsHitTestVisible="False"
        Foreground="{StaticResource ReminderTextBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        SnapsToDevicePixels="True">
    <Border CornerRadius="10"
            Background="{StaticResource ReminderSurfaceBrush}"
            Padding="18,14">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="通知標題" />
            <TextBlock x:Name="MessageText"
                       FontSize="13"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       LineStackingStrategy="BlockLineHeight"
                       Margin="0,6,0,0"
                       AutomationProperties.Name="通知內容" />
        </StackPanel>
    </Border>
</Window>
