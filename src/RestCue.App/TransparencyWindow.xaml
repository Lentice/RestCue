<Window x:Class="RestCue.App.TransparencyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestCue – 資料透明檢視" Height="480" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True">
    <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="資料透明檢視" />
            <TextBlock Margin="0,4,0,16" Foreground="#666666" FontSize="13"
                       Text="RestCue 只在本機處理與保存資料，以下為實際狀態。" />

            <TextBlock x:Name="StatusText" FontSize="14" FontWeight="SemiBold"
                       Foreground="#CC0000" Visibility="Collapsed" />

            <Border Padding="16" CornerRadius="8" Background="#FFF3F4F6">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold"
                               Text="資料類別狀態" />
                    <ItemsControl x:Name="CategoryList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1"
                                               FontWeight="SemiBold"
                                               Text="{Binding State}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Padding="16" CornerRadius="8"
                    Background="#FFF3F4F6">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold"
                               Text="事件類型統計" />
                    <TextBlock x:Name="TotalCountText" Margin="0,4,0,0"
                               Foreground="#666666" FontSize="13" />
                    <ItemsControl x:Name="EventTypeCountList" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding EventType}" />
                                    <TextBlock Grid.Column="1"
                                               FontWeight="SemiBold"
                                               Text="{Binding Count}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EarliestText" Margin="0,8,0,0"
                               Foreground="#666666" FontSize="13" />
                    <TextBlock x:Name="LatestText" Margin="0,2,0,0"
                               Foreground="#666666" FontSize="13" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
